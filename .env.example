# ===========================================================================
# 环境变量模板 —— 复制为 .env 后按需修改
# 优先级：进程环境变量 > .env > finance_rag/src/core/config.py 默认值  |  修改后需重启服务
# 生产环境（APP_ENV=production）会校验下方生产必填项并拒绝默认值。
# 仅列出必填与常用配置；其余变量（超时/重试/切块尺寸/评估参数等）沿用默认值，
# 完整清单见 finance_rag/src/core/config.py
# ===========================================================================

# --- 运行环境 ---
APP_ENV=development

# --- 安全配置（必填）---
# JWT 密钥（必填，强随机字符串，至少 32 字符）
# 生成命令：python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=replace-with-a-strong-random-secret-at-least-32-chars
# 单管理员账号
JWT_ADMIN_USERNAME=admin
JWT_ADMIN_PASSWORD=please-change-me

# --- LLM（必填）---
# DeepSeek API Key：聊天 / A/B 评估均依赖此项
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_MODEL=
# 生成温度（0.0-2.0）：较低温度降低随机性、减少幻觉
LLM_TEMPERATURE=0.1

# --- 查询改写轻量模型（可选，默认复用 DASHSCOPE_API_KEY 走 qwen-turbo）---
# 查询改写优先使用轻量小模型降低延迟；未配置 key 时回退到主模型 DEEPSEEK_MODEL，
# 再回退到纯规则改写。可自定义端点/模型/超时：
# QUERY_REWRITE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QUERY_REWRITE_MODEL=qwen-turbo
# QUERY_REWRITE_API_KEY=sk-your-dashscope-key
# QUERY_REWRITE_TIMEOUT_SECONDS=15

# --- 评测裁判与校准（可选；A/B 评估用，不影响线上问答）---
# 生成侧指标固定为 RAGAS 四指标：faithfulness / answer_relevancy /
# context_precision / context_recall。
# 主裁判默认复用 DEEPSEEK_MODEL；如需换裁判模型：
# EVAL_JUDGE_MODEL=deepseek:deepseek-v4-pro
# EVAL_JUDGE_BASE_URL=
# EVAL_JUDGE_API_KEY=sk-your-judge-key
# 第二裁判（跨模型交叉校验，防「自我强化偏差」）：默认复用查询改写的
# qwen-turbo（与 DeepSeek 不同模型族），与主裁判同族时会自动跳过校验。
# EVAL_JUDGE_SECONDARY_MODEL=qwen-turbo
# EVAL_JUDGE_SECONDARY_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EVAL_JUDGE_SECONDARY_API_KEY=sk-your-dashscope-key
# 锚点样本（分数已知的黄金用例）：每批评估都跑，监控 judge 标准漂移
# EVAL_ANCHORS_PATH=finance_rag/src/eval/data/eval_anchors.jsonl
# 锚点越界是否直接判本次实验失败（默认只报告）
# EVAL_ANCHOR_STRICT=false
# 锚点区间放宽量（LLM judge 有抖动，默认 0.1）
# EVAL_ANCHOR_BAND_SLACK=0.1
# 成对裁判默认题数 / 第二裁判默认题数 / 人工标注默认条数（0=关闭）
# EVAL_PAIRWISE_SAMPLE=20
# EVAL_CROSSCHECK_SAMPLE=0
# EVAL_HUMAN_SAMPLE_SIZE=60
# 偏差判定阈值：换序翻转率、分数-长度秩相关、长度匹配比、跨模型偏置
# EVAL_POSITION_FLIP_THRESHOLD=0.3
# EVAL_LENGTH_CORR_THRESHOLD=0.3
# EVAL_LENGTH_MATCH_RATIO=1.25
# EVAL_JUDGE_BIAS_THRESHOLD=0.1

# --- 嵌入模型（本地 ONNX INT8）---
# 模型、维度和池化方式必须与 Milvus 集合及已入库向量一致：
#   BAAI/bge-m3 → 1024 维 dense embedding，使用归一化 CLS token
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
# 可选 cls|mean；BGE-M3 默认并推荐 cls，mean 仅用于兼容其他模型
EMBEDDING_POOLING=cls
# 嵌入输入窗口（token）。bge-m3 本体支持 8192，但 CPU 上长序列开销超线性
# （实测 512→1369 token 单条推理 0.41s→6.2s），检索用 512 足够且更快。
# 它是子块上限的「余量」而非目标：表头+摘要这类原子块不受子块上限约束，
# 需要这个窗口兜住（实测最大原子块约 311 token）。
EMBEDDING_MAX_TOKENS=512
# HuggingFace 镜像端点（国内无法直连 huggingface.co 时使用，留空走官方源）
HF_ENDPOINT=https://hf-mirror.com
# 本地模型缓存与离线模式（生产部署建议提前完成模型缓存）
MODEL_CACHE_DIR=./assets/models
MODEL_OFFLINE=false
HF_HUB_OFFLINE=false
TRANSFORMERS_OFFLINE=false
EMBED_BATCH_SIZE=25
OMP_NUM_THREADS=4
MKL_NUM_THREADS=4

# --- 向量数据库（Milvus）---
MILVUS_URI=http://localhost:19530
KB_COLLECTION_NAME=finance_kb

# --- 关系型数据库与缓存 ---
POSTGRES_DB=finance_rag
POSTGRES_USER=finance_rag_app
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password
DATABASE_URL=postgresql+psycopg://finance_rag_app:${POSTGRES_PASSWORD}@localhost:5432/finance_rag
REDIS_PASSWORD=replace-with-a-strong-redis-password
REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:6379/0
REDIS_CACHE_PREFIX=finance_rag
REDIS_TIMEOUT_SECONDS=2
# 增量处理指纹的运行时状态目录（父块全文已迁移至 PostgreSQL 的 parent_chunks 表）
MILVUS_FINGERPRINT_PATH=./assets/state/.milvus_fingerprint

# --- 扫描版 PDF 云端 OCR（可选，未配置则跳过云端 OCR）---
LLAMA_CLOUD_API_KEY=

# --- 文档图片处理（PDF 嵌入图片自动提取 + 多模态描述）---
# 提取 PDF 内嵌图片并保存到存储：始终执行（依赖 pymupdf）；
# 生成图片文字描述：需 DASHSCOPE_API_KEY，未配置时仅保存图片、描述为占位提示。
DASHSCOPE_API_KEY=
# 视觉模型端点（OpenAI 兼容，默认 DashScope Qwen-VL）
# IMAGE_CAPTION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# IMAGE_CAPTION_MODEL=qwen-vl-max
# 未单独配置时复用 DASHSCOPE_API_KEY；每次成功外发都会写 image_egress 审计
# IMAGE_CAPTION_API_KEY=
# IMAGE_CAPTION_TIMEOUT_SECONDS=30
# IMAGE_CAPTION_MAX_IMAGES=10
# IMAGE_CAPTION_MAX_RETRIES=2
# IMAGE_CAPTION_MIN_DIM_PX=80
# IMAGE_CAPTION_MIN_BYTES=5000

# --- MinerU 文档解析（Python API）---
# 固定依赖 mineru==3.4.5，通过 mineru.cli.common.do_parse 进程内调用。
# pipeline 适合本地 CPU/GPU；首次运行会按 MinerU 配置下载模型。
MINERU_BACKEND=pipeline
MINERU_METHOD=auto
MINERU_FORMULA_ENABLE=true
MINERU_TABLE_ENABLE=true
MINERU_OUTPUT_DIR=./assets/state/mineru
MINERU_MAX_CONCURRENCY=2
MINERU_KEEP_ARTIFACTS_ON_ERROR=false

# 保守清洗 / 表格位置保留；版本变化需重新解析入库，不能复用旧指纹。
CLEANER_RULES_VERSION=mineru-cleaner-v2-preserve
CHUNK_RULES_VERSION=hierarchical-v3-preserve

# --- 入库流水线（进程单例常驻队列 + 分阶段 Executor）---
# 提交 ─► in_queue ─► [解析 worker] ─► parse_queue ─► [切块 worker]
#                                                        │
#  写入 ◄─ [写入 worker] ◄─ write_queue ◄─ [Embedding worker] ◄─ chunk_queue
# 文档上传完成即入队（submit），入队即返回：不等同批其它文档，
# 阶段重叠覆盖整个服务会话；队列满时接口返回 503（背压）而非阻塞调用方。
INGEST_PIPELINE_ENABLED=true
# 切块进程池 worker 数；0 = 自动（min(4, max(1, CPU 核数 // 2))）。
# 切块阶段的常驻消费者数会与之一致（少于此数会让进程池退化为串行）。
# 注意：ENABLE_SEMANTIC_CHUNKER=true 时每个 worker 会各自加载句向量模型，
# 内存按 worker 数翻倍，建议此时显式设为 1。
INGEST_CHUNK_WORKERS=0
# 切块内联阈值：markdown 短于该长度时不进进程池（进程往返开销大于收益）
INGEST_CHUNK_MIN_CHARS=60000
# 阶段间队列容量（背压上限）：每个队列同时滞留的待入库文档数，最小 1
INGEST_QUEUE_MAXSIZE=16
# Embedding 线程池 worker 数（session.run 仍串行，用于重叠分批提交）
INGEST_EMBED_WORKERS=2
# 写入阶段消费者数。写库分两阶段：阶段 A（原文件/图片/解析 md 落存储）是网络 IO，
# 多消费者可并行；阶段 B（向量库「删旧行 + 插新行」+ 文档间 SimHash 去重 + 指纹）
# 由写锁强制串行。设为 1 即回到完全串行；存储为 OSS/S3 时收益最明显。
INGEST_WRITE_WORKERS=2
# 解析线程池大小（MinerU 在父进程内执行；解析并发上限 = MINERU_MAX_CONCURRENCY）
DOCUMENT_PARSE_WORKERS=4
# 常驻 worker 监督间隔：检查阶段 worker 是否意外退出并重启（秒）
INGEST_SUPERVISOR_INTERVAL_SECONDS=1.0
# 各阶段队列深度采样间隔（Prometheus gauge，秒）
INGEST_METRICS_INTERVAL_SECONDS=2.0
# 关闭时等待在途文档结算的最长秒数，超时强制结算为失败（秒）
INGEST_DRAIN_TIMEOUT_SECONDS=10.0

# --- 文档切块 ---
# 子块 token 预算：chunker 按 _CHARS_PER_TOKEN=1.4 折算成字符上限
# （256 → 358 字符、重叠 25 → 35 字符）。这是「检索单元」的粒度上限：
#   - 太大 = 等于没在管粒度（512 token 时只有 23% 的父块被切开），块尾还会被嵌入截断；
#   - 太小 = 退化成碎片（128 token 时 99% 的子块不足 200 字符）；
# 实测 256 是两者之间的拐点（39% 的父块被切开、token p90=215）。
# 回归守卫见 tests/unit/test_chunker.py。
DOCLING_CHUNK_MAX_TOKENS=256
CHILD_OVERLAP_TOKENS=25
# 语义分块：本地句子嵌入检测语义断点（开启后替代递归字符切分，首次使用需下载小模型）
ENABLE_SEMANTIC_CHUNKER=false

# --- 版本策略 ---
# 版本保留：true 时同一文档保留历史版本（检索仅命中最新版）；
# 开启前需集合含 version 字段（旧集合请调用 rebuild_collection 重建）
ENABLE_VERSIONING=false
# 每文档最多保留版本数（0 = 无限，超出自动删除最旧版本）
MAX_VERSIONS_PER_DOC=0

# --- 重排序 ---
ENABLE_RERANKER=true
# 启动预热：true 时在后台线程预热「重依赖导入 + 嵌入/重排序模型」，不阻塞端口绑定；
# 就绪性由 /api/health/ready 报告（预热完成前返回 503）。
# false 则完全跳过预热，模型在首次调用时惰性加载（首个请求会明显变慢）。
WARMUP_ENABLED=true
# 本机有 GPU 时可用 cuda；无 GPU 保持 cpu
RERANKER_DEVICE=cpu
# 断崖检测（三约束，作用在**粗排候选**上：在断崖处截断低质尾部后再送重排）
# 1) 绝对差距：相邻粗排分差 >= 该值即判为断崖（<=0 关闭本规则）
RERANKER_CLIFF_ABS_THRESHOLD=0.8
# 2) 相对跌幅：相邻跌幅 (s[i]-s[i+1])/s[i] >= 该值即判为断崖（<=0 关闭本规则）
RERANKER_CLIFF_REL_THRESHOLD=0.40
# 3) 兜底：命中断崖也至少保留这么多条，避免上下文完全缺失（且不低于精排请求条数）
RERANKER_CLIFF_MIN_TOP_K=5
# 重排后最终选取的多样性配额（gold20 复盘：表格霸占 top-5、单文档霸榜挤掉
# 跨文档证据）。作用于重排之后的最终 top-N 选取，配额耗尽时按顺位回填。
# 0 = 关闭对应配额。
RERANK_MAX_PER_SOURCE=2
RERANK_MAX_NON_TEXT_BLOCKS=2
# HuggingFace 模型缓存目录（嵌入模型 + reranker 共用）：
# 本地开发默认 ~/.cache/huggingface；Docker 部署固定为 /app/onnx_cache/hf_home（已持久化）
# HF_HOME=~/.cache/huggingface

# --- 问答链路 ---
# 粗排深度 / 精排条数：统一常量，不随问题复杂度分档
CHAT_TOP_K=50
CHAT_RERANK_TOP_K=5
# HyDE：先让 LLM 生成假设性回答，用其向量增强检索（每次额外 1 次 LLM 调用）
ENABLE_HYDE=false

# --- RAG 优化开关（默认关闭，逐个启用并用 A/B 测试验证效果）---
# 引用验证机制（验证回答中引用是否与来源匹配）
ENABLE_CITATION_VALIDATION=true
# 拒答机制：检索为空/相关性不足/引用校验低分时拒绝回答
ENABLE_REFUSAL=true
# LangGraph Agentic RAG（改写→检索→反思→重检索循环）
ENABLE_LANGGRAPH=false
# 初检后最多2批补检；简单问题不拆分，复杂问题最多3个必要事项。
LANGGRAPH_MAX_REFLECT_ROUNDS=2
AGENT_MAX_SUBPROBLEMS=3

# --- 文档上传 ---
UPLOAD_DIR=./files
MAX_UPLOAD_SIZE_MB=20

# --- 云存储（阿里云 OSS，存储桶需预先创建）---
STORAGE_BACKEND=oss
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=finance-rag-docs
OSS_REGION=cn-hangzhou
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
